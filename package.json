{
  "name": "gestion-tareas",
  "private": true,
  "version": "1.4.0",
  "description": "Sistema de Productividad Personal Local-First (Tareas, Hábitos, Calendario, Objetivos)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "dev:server": "npm run dev -w server",
    "build:server": "npm run build -w server",
    "start:server": "npm run start -w server",
    "db:setup": "npm run db:setup -w server",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:reset -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w client",
    "sql:gen": "npm run sql:gen -w client",
    "desktop:dev": "npm run tauri:dev -w client",
    "desktop:build": "npm run tauri:build -w client",
    "desktop:build:offline": "npm run tauri:build:offline -w client",
    "android:dev": "npm run android:dev -w client",
    "android:build": "npm run android:build -w client",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=24"
  }
}
