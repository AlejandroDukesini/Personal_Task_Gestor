{
  "name": "gestion-tareas",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de Productividad Personal Local-First (Tareas, Hábitos, Calendario, Objetivos)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
