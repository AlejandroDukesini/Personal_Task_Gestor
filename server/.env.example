# Plantilla de variables de entorno del servidor Express (solo uso local).
# Copiar a `server/.env` y ajustar. El fichero .env real NUNCA se versiona.

# Cadena de conexión de Prisma. Con SQLite el fichero contiene todos los datos
# personales en claro: mantenerlo fuera de carpetas sincronizadas (Drive,
# Dropbox, OneDrive) y fuera del control de versiones.
DATABASE_URL="file:./dev.db"

# Puerto de escucha de la API.
PORT=4000

# Interfaz de escucha. 127.0.0.1 (por defecto) mantiene la API accesible solo
# desde este equipo. Cambiar a 0.0.0.0 la publica en toda la red local, donde
# queda accesible SIN autenticación: hacerlo solo en una red de confianza.
HOST=127.0.0.1

# Orígenes adicionales permitidos por CORS, separados por comas.
# Los puertos de Vite en loopback (5173 y 4173) ya están permitidos.
# CORS_ORIGINS=

# Poner a "true" solo si la API corre detrás de un proxy inverso de confianza.
# Si se activa sin proxy, cualquiera puede falsear X-Forwarded-For y esquivar
# el límite de peticiones.
# TRUST_PROXY=false
